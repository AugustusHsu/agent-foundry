{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--isolated",
        "--headless",
        "--viewport",
        "1280x720"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--browser",
        "chrome",
        "--isolated",
        "--headless",
        "--viewport-size",
        "1280x720",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
